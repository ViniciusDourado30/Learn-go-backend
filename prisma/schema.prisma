generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  nome      String
  sobrenome String
  email     String   @unique
  password  String
  role      Role     @default(ALUNO)
  idade     Int?
  pais      String?
  estado    String?
  cidade    String?
  telefone  String?
  formacao  String?
  linkedin  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  alunoProfile     AlunoProfile?
  professorProfile ProfessorProfile?
  aulasAgendadas   AulaAgendada[]
  matriculas       MatriculaCurso[]

  @@map("users")
}

enum Role {
  ALUNO
  PROFESSOR
}

model AlunoProfile {
  id        String  @id @default(uuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade) 
  nome      String
  sobrenome String
  idade     Int
  pais      String
  estado    String
  cidade    String
  telefone  String?
  ocupacao  String?
  idioma    String?
  sobre     String?
  foto_url  String? 

  @@map("aluno_profiles")
}

model ProfessorProfile {
  id               String  @id @default(uuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome             String
  sobrenome        String
  idade            Int
  pais             String
  estado           String
  cidade           String
  comprovante_url  String? 
  telefone         String?
  ocupacao         String?
  idiomas          String[] // Add from UI
  especialidades   String[] // Add from UI
  sobre            String?
  foto_url         String? 
  rating           Float   @default(5.0)
  total_reviews    Int     @default(0)
  duracao_aula     Int     @default(60)
  intervalo_aula   Int     @default(0)
  preco_medio      Float   @default(0.0)

  cursos           Curso[]
  disponibilidades DisponibilidadeBloco[]
  aulasAgendadas   AulaAgendada[]

  @@map("professor_profiles")
}

model Curso {
  id          String   @id @default(uuid())
  titulo      String
  descricao   String
  preco       Float
  categoria   String
  capa_url    String?
  cliques     Int      @default(0)
  professorId String
  professor   ProfessorProfile @relation(fields: [professorId], references: [id], onDelete: Cascade)
  modulos     Modulo[]
  matriculas  MatriculaCurso[]
  criado_em   DateTime @default(now())
  @@map("cursos")
}

model Modulo {
  id        String  @id @default(uuid())
  titulo    String  
  ordem     Int     
  cursoId   String
  curso     Curso   @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  aulas     Aula[]
  @@map("modulos")
}

model Aula {
  id        String  @id @default(uuid())
  titulo    String  
  video_url String? 
  ordem     Int     
  moduloId  String
  modulo    Modulo  @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  @@map("aulas")
}

model MatriculaCurso {
  id        String   @id @default(uuid())
  alunoId   String
  aluno     User     @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  cursoId   String
  curso     Curso    @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  progresso Int      @default(0)
  criado_em DateTime @default(now())

  @@unique([alunoId, cursoId])
  @@map("matriculas_cursos")
}

model DisponibilidadeBloco {
  id          String @id @default(uuid())
  professorId String
  professor   ProfessorProfile @relation(fields: [professorId], references: [id], onDelete: Cascade)
  dia_semana  Int    
  hora_inicio String 
  hora_fim    String 
  preco       Float  
  @@map("disponibilidade_blocos")
}

model AulaAgendada {
  id                String   @id @default(uuid())
  alunoId           String
  aluno             User     @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  professorId       String
  professor         ProfessorProfile @relation(fields: [professorId], references: [id], onDelete: Cascade)
  data_aula         String   
  hora_inicio       String   
  hora_fim          String   
  preco_cobrado     Float    
  assunto           String?  
  link_reuniao      String?  
  id_reuniao_zoom   String?  
  stripe_payment_id String?  
  status            String   @default("PENDENTE_PAGAMENTO") 
  criado_em         DateTime @default(now())
  @@map("aulas_agendadas")
}