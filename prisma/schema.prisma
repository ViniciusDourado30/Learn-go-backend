// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Extensão para suportar busca vetorial de rostos
// No Supabase, você precisará executar: CREATE EXTENSION IF NOT EXISTS vector;
enum Role {
  ALUNO
  PROFESSOR
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  senha_hash   String
  role         Role
  criado_em    DateTime  @default(now())
  
  alunoProfile     AlunoProfile?
  professorProfile ProfessorProfile?

  @@map("users")
}

model AlunoProfile {
  id        String @id @default(uuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id])
  
  nome      String
  sobrenome String
  idade     Int
  pais      String
  estado    String
  cidade    String
  
  // O tipo 'Unsupported' é usado pois o Prisma ainda não tem suporte nativo ao tipo vector
  biometria_vector Unsupported("vector(128)")? 

  @@map("aluno_profiles")
}

model ProfessorProfile {
  id           String @id @default(uuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id])
  
  nome         String
  sobrenome    String
  idade        Int
  pais         String
  estado       String
  cidade       String
  comprovante_url String? 
  
  biometria_vector Unsupported("vector(128)")?

  @@map("professor_profiles")
}