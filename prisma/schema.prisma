// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// AUTENTICAÇÃO E USUÁRIOS
// ==========================================

model User {
  id        String   @id @default(uuid())
  nome      String
  sobrenome String
  email     String   @unique
  password  String
  role      Role     @default(ALUNO)
  
  // Novos campos do frontend
  idade     Int?
  pais      String?
  estado    String?
  cidade    String?
  telefone  String?
  formacao  String?
  linkedin  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relacionamentos inversos para o Prisma entender a conexão
  alunoProfile     AlunoProfile?
  professorProfile ProfessorProfile?

  aulasAgendadas AulaAgendada[]

  @@map("users")
}

enum Role {
  ALUNO
  PROFESSOR
}

// ==========================================
// PERFIS
// ==========================================

model AlunoProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade) 
  
  // Dados obrigatórios do registro
  nome             String
  sobrenome        String
  idade            Int
  pais             String
  estado           String
  cidade           String
  
  // Dados opcionais da tela de edição de perfil
  telefone         String?
  ocupacao         String?
  idioma           String?
  sobre            String?
  foto_url         String? 

  @@map("aluno_profiles")
}

model ProfessorProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Dados obrigatórios do registro
  nome             String
  sobrenome        String
  idade            Int
  pais             String
  estado           String
  cidade           String
  comprovante_url  String? 
  
  // Dados opcionais da tela de edição de perfil
  telefone         String?
  ocupacao         String?
  idioma           String?
  sobre            String?
  foto_url         String? 

  duracao_aula     Int      @default(60)
  intervalo_aula   Int      @default(0)
  preco_medio      Float    @default(0.0)

  // Relacionamento com os cursos criados por este professor
  cursos           Curso[]
  disponibilidades DisponibilidadeBloco[]
  aulasAgendadas AulaAgendada[]

  @@map("professor_profiles")
}

// ==========================================
// ESTRUTURA DE CURSOS
// ==========================================

model Curso {
  id          String   @id @default(uuid())
  titulo      String
  descricao   String
  preco       Float
  categoria   String
  capa_url    String?
  
  // Relação: Qual professor é o dono deste curso?
  professorId String
  professor   ProfessorProfile @relation(fields: [professorId], references: [id], onDelete: Cascade)
  
  // Relação: Um curso tem vários módulos
  modulos     Modulo[]
  
  criado_em   DateTime @default(now())

  @@map("cursos")
}

model Modulo {
  id        String  @id @default(uuid())
  titulo    String  // Ex: "Módulo 1"
  ordem     Int     // Posição do módulo no curso
  
  // Relação: A qual curso este módulo pertence?
  cursoId   String
  curso     Curso   @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  
  // Relação: Um módulo tem várias aulas
  aulas     Aula[]

  @@map("modulos")
}

model Aula {
  id        String  @id @default(uuid())
  titulo    String  // Nome da aula
  video_url String? // URL do vídeo no storage/YouTube/Vimeo
  ordem     Int     // Posição da aula dentro do módulo
  
  // Relação: A qual módulo esta aula pertence?
  moduloId  String
  modulo    Modulo  @relation(fields: [moduloId], references: [id], onDelete: Cascade)

  @@map("aulas")
}

model DisponibilidadeBloco {
  id          String @id @default(uuid())
  professorId String
  professor   ProfessorProfile @relation(fields: [professorId], references: [id], onDelete: Cascade)

  dia_semana  Int    // 0 = Domingo, 1 = Segunda, 2 = Terça... 6 = Sábado
  hora_inicio String // Ex: "09:00"
  hora_fim    String // Ex: "18:00"
  preco       Float  // Preço cobrado neste bloco

  @@map("disponibilidade_blocos")
}

model AulaAgendada {
  id                String   @id @default(uuid())
  
  // Relacionamento com quem agendou (Aluno)
  alunoId           String
  aluno             User     @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  
  // Relacionamento com quem vai dar a aula (Professor)
  professorId       String
  professor         ProfessorProfile @relation(fields: [professorId], references: [id], onDelete: Cascade)

  // Dados do agendamento vindos do Front
  data_aula         String   // Formato YYYY-MM-DD
  hora_inicio       String   // Ex: "09:00"
  hora_fim          String   // Ex: "10:00"
  preco_cobrado     Float    // Preço no momento do agendamento
  assunto           String?  // Opcional ("O que gostaria de estudar?")

  // Gerado pelo Backend
  link_reuniao      String?  // Agora é opcional, pois só será gerado APÓS o pagamento
  id_reuniao_zoom   String?  // Vamos guardar o ID oficial do Zoom aqui
  
  stripe_payment_id String?  
  status            String   @default("PENDENTE_PAGAMENTO") 

  criado_em         DateTime @default(now())
  
  @@map("aulas_agendadas")
}